PORT=4242
PUBLIC_BASE_URL=http://localhost:4242

# SMTP du service d’email. Laisser vide uniquement pour un essai local avec MAIL_CAPTURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
MAIL_FROM="Facile Pro <contact@facilepro.fr>"
# MAIL_CAPTURE=true conserve les messages en mémoire et n’envoie rien. Réservé aux essais.

BUSINESS_NAME=Facile Pro
BUSINESS_EMAIL=contact@facilepro.fr
BUSINESS_ADDRESS=Route de Belcastel, 12390 Mayran, France

# Les identifiants officiels de la SASU (ouverture prévue le 5 décembre 2026)
# se saisissent dans l’administration. Ne pas y remettre ceux de l’ancienne entreprise radiée.
DATABASE_URL=postgresql://user:password@host:5432/facilepro?sslmode=require

# Espace client sécurisé : dépôt de pièces justificatives (désactivé tant que la sécurité n'est pas validée).
DOCUMENTS_UPLOAD_ENABLED=false
# 64 caractères hexadécimaux. Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne jamais la perdre ni la changer : sans elle, les documents déjà déposés deviennent illisibles.
DOCUMENTS_ENCRYPTION_KEY=
DOCUMENTS_RETENTION_DAYS=90
# Adresses (séparées par des virgules) des comptes vérifiés autorisés au tableau de bord /admin.html.
ADMIN_EMAILS=contact@facilepro.fr
# Secret utilisé par Vercel Cron pour la suppression quotidienne des documents expirés.
CRON_SECRET=
